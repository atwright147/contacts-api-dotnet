{
  "compilerOptions": {
    // tell TS to look at package.json "imports"
    "moduleResolution": "bundler",

    // allow importing .ts/.tsx files without extensions
    "allowImportingTsExtensions": true,

    // stop TS complaining about missing emit for extensions
    "noEmit": true
  },
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
