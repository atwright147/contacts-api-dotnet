      "~src/*": ["./src/*"],
      "~ref/*": ["./ref/*"],
      "~stores/*": ["./src/stores/*"],
      "~types/*": ["./src/types/*"],
      "~routes/*": ["./src/routes/*"],
      "~components/*": ["./src/components/*"],
      "~hooks/*": ["./src/hooks/*"],
      "~utils/*": ["./src/utils/*"],
    },
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
